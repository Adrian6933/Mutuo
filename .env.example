# Config web de Firebase (Consola → Configuración del proyecto → Tus apps → Web)
# Copia este archivo a `.env` y rellena los valores. Son claves públicas (van en el bundle).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_DATABASE_URL=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
