{
  "rules": {
    ".read": false,
    ".write": false,
    "lobbies": {
      ".indexOn": [
        "meta/public"
      ],
      ".read": "auth != null",
      "$lobbyId": {
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || (newData.child('hostUid').val() === auth.uid && (!root.child('lobbies').child($lobbyId).child('players').child(data.child('hostUid').val()).exists() || root.child('lobbies').child($lobbyId).child('players').child(data.child('hostUid').val()).child('online').val() != true || root.child('lobbies').child($lobbyId).child('players').child(data.child('hostUid').val()).child('seen').val() < (now - 240000))))"
        },
        "config": {
          ".write": "auth != null && root.child('lobbies').child($lobbyId).child('meta/hostUid').val() === auth.uid"
        },
        "game": {
          ".write": "auth != null && root.child('lobbies').child($lobbyId).child('meta/hostUid').val() === auth.uid"
        },
        "assign": {
          ".write": "auth != null && root.child('lobbies').child($lobbyId).child('meta/hostUid').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('lobbies').child($lobbyId).child('meta/hostUid').val() === auth.uid)"
          }
        },
        "actions": {
          ".write": "auth != null && root.child('lobbies').child($lobbyId).child('players').child(auth.uid).exists() || root.child('lobbies').child($lobbyId).child('meta/hostUid').val() === auth.uid"
        },
        "live": {
          ".write": "auth != null && root.child('lobbies').child($lobbyId).child('players').child(auth.uid).exists()"
        },
        ".write": "auth != null && (!data.exists() || root.child('lobbies').child($lobbyId).child('meta/hostUid').val() === auth.uid || (!newData.exists() && (data.child('meta/updatedAt').val() < (now - 3600000) || (!data.child('meta/updatedAt').exists() && (!data.child('meta/createdAt').exists() || data.child('meta/createdAt').val() < (now - 3600000))))))"
      }
    }
  }
}
